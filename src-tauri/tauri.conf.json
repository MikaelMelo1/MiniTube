{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiniTube",
  "version": "0.1.0",
  "identifier": "com.minitube.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "minHeight": 50,
        "height": 68,
        "label": "main",
        "resizable": true,
        "alwaysOnTop": true,
        "center": false,
        "title": "MiniTube",
        "minWidth": 50,
        "width": 68,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; connect-src 'self' https://www.googleapis.com https://www.youtube.com https://youtubei.googleapis.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
